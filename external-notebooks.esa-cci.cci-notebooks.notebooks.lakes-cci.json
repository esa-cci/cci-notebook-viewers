, 38, 1), crs=ccrs.PlateCarree())  # longitude ticks\nax.set_yticks(range(2, 6, 1), crs=ccrs.PlateCarree())  # latitude ticks\nax.set_xlabel(\"Longitude\")\nax.set_ylabel(\"Latitude\")\nplt.tight_layout()\nplt.show()","key":"c7kiDgZPfW"},{"type":"outputs","id":"K5w9cLPWUjUUNVrcDt_kH","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"1c02d07b7c3c04935e8cc09631ca900f","path":"/cci-notebook-viewers/build/1c02d07b7c3c04935e8cc09631ca900f.png"},"text/plain":{"content":"<Figure size 1200x600 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"iGoCKEJPSO"}],"key":"ITOrwIgBIb"}],"key":"jYWqLiObNq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"If we want to visualise the time series of the lake temperature accross the defined region, in this case Lake Turkana, we can do so by using the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IwduR712g5"},{"type":"inlineCode","value":"tseries_mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PQv71oKbO6"},{"type":"text","value":" operation. The calculated time series will be saved into a new dataset and plotted in a next step.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KDZQIkRVKa"}],"key":"iZjbygIv8H"}],"key":"x6sziEuRrb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tseries_mean = get_op(\"tseries_mean\")","key":"jenpeshlQC"},{"type":"outputs","id":"FJ_YFVuKF5oxK1Jw7CuVg","children":[],"key":"TJCIaysNKZ"}],"key":"LKhLVKao3Y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds_mean = tseries_mean(lake_turkana_ds, \"lake_surface_water_temperature\")\nds_mean","key":"Zj8W9kMI